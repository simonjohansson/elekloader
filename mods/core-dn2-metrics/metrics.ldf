ARCHITECTURE(ADSP-21569)
$OBJECTS=$COMMAND_LINE_OBJECTS;
MEMORY {
 code { TYPE(BW RAM) START(0x002dda00) END(0x002ddcbf) WIDTH(8) }
 data { TYPE(BW RAM) START(0x002ddd00) END(0x002ddd97) WIDTH(8) }
}
PROCESSOR p0 {
 OUTPUT($COMMAND_LINE_OUTPUT_FILE)
 SECTIONS {
  metrics_code SW { INPUT_SECTION_ALIGN(2) INPUT_SECTIONS($OBJECTS(seg_swco)) } > code
  metrics_data BW { INPUT_SECTION_ALIGN(4) INPUT_SECTIONS($OBJECTS(seg_dmda)) } > data
 }
}
